# Tat ca deu co mac dinh dung cho production; chi ghi de khi can.
# API_BASE_URL=https://hocphi-info-api.fly.dev
# WEB_BASE_URL=https://hocphi.info
# HTTP_TIMEOUT_S=12
# HTTP_MAX_ATTEMPTS=3
# CACHE_TTL_LISTS_S=600
# CACHE_TTL_DETAIL_S=120
# CACHE_MAX_ENTRIES=256
# LOG_LEVEL=INFO

# ── May chu HTTP ──
# PORT=8080
# Host duoc phep (chong DNS rebinding), phan tach bang dau phay. Production: host cua Cloud Run.
# ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*
# MAX_BODY_BYTES=65536
# RATE_LIMIT_PER_MINUTE=60
# RATE_LIMIT_BURST=20
# RATE_LIMIT_MAX_CLIENTS=10000
# TRUSTED_PROXY_HOPS=1
# GCP_PROJECT=            # co gia tri thi log co logging.googleapis.com/trace
